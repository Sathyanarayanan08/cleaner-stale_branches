import os
import requests
from dotenv import load_dotenv
from datetime import datetime, timedelta

load_dotenv()

GITHUB_TOKEN = os.getenv('GITHUB_TOKEN')
if not GITHUB_TOKEN:
    print("GitHub Token is missing!")
    exit(1)

headers = {
    "Authorization": f"token {GITHUB_TOKEN}",
    "Accept": "application/vnd.github.v3+json"
}

def get_repositories():
    with open("masterRepoList.txt", "r") as file:
        repos = file.readlines()
    return [repo.strip() for repo in repos]

def get_branches(repo):
    url = f"https://api.github.com/repos/{repo}/branches"
    response = requests.get(url, headers=headers)
    if response.status_code == 200:
        return response.json()
    else:
        print(f"Failed to fetch branches for {repo}: {response.status_code}")
        return []

def is_stale(branch):
    # Get the commit date of the branch
    commit_date = branch['commit']['commit']['author']['date']
    commit_date = datetime.strptime(commit_date, "%Y-%m-%dT%H:%M:%SZ")
    one_year_ago = datetime.now() - timedelta(days=365)

    return commit_date < one_year_ago

def delete_branch(repo, branch):
    url = f"https://api.github.com/repos/{repo}/git/refs/heads/{branch}"
    response = requests.delete(url, headers=headers)
    if response.status_code == 204:
        print(f"Successfully deleted branch {branch} from {repo}")
    else:
        print(f"Failed to delete branch {branch} from {repo}: {response.status_code}")


def manage_branches(repo):
    branches = get_branches(repo)
    stale_branches = [branch['name'] for branch in branches if is_stale(branch)]

    if not stale_branches:
        print(f"No stale branches found for {repo}.")
        return

    print(f"Stale branches in {repo}:")
    for i, branch in enumerate(stale_branches, 1):
        print(f"{i}. {branch}")

    delete_input = input(f"Enter the numbers of branches to delete (comma-separated, or 'all' to delete all): ")
    if delete_input == "all":
        branches_to_delete = stale_branches
    else:
        branches_to_delete = [stale_branches[int(i) - 1] for i in delete_input.split(",")]

    for branch in branches_to_delete:
        delete_branch(repo, branch)

# Main function to clean repositories
def clean_repositories():
    repositories = get_repositories()
    for repo in repositories:
        print(f"Processing repository: {repo}")
        manage_branches(repo)

    print("Cleaning process completed.")

if __name__ == "__main__":
    clean_repositories()